# ---------------------------------------------------------------------------
# OmniStore environment
#
# Every variable below is OPTIONAL — the app runs with sane defaults and talks
# to OmniSource for all data. Never put a secret in a NEXT_PUBLIC_* variable:
# those are shipped to the browser.
# ---------------------------------------------------------------------------

# --- Data source ------------------------------------------------------------

# Base URL of a live OmniSource deployment, e.g. https://api.omnisource.dev/v1
#
# Server-side value. Leave empty to serve the bundled catalog in
# data/omnisource-feed.json in-process — the storefront is fully populated out
# of the box with zero configuration. Set this to use a live deployment.
OMNISOURCE_API_URL=

# Optional: exposes the URL to the browser for direct client-side reads.
# Never put a secret in this variable — it ships to the browser.
NEXT_PUBLIC_OMNISOURCE_API_URL=

# --- Site -------------------------------------------------------------------

# Public origin. Used for canonical URLs, Open Graph tags, sitemap.xml and
# robots.txt. Set this in every deployed environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Version reported by /api/v1/health.
NEXT_PUBLIC_OMNISTORE_VERSION=1.0.0

# --- Features ---------------------------------------------------------------

# Anonymous product analytics (page views, searches, download clicks).
# No cookies, no advertising identifiers, no third-party scripts. Off by default.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

FEATURE_COMPARISON=true
FEATURE_FAVORITES=true
FEATURE_COLLECTIONS=true
FEATURE_REPORTING=true
FEATURE_PWA=true

# Not implemented: the UI never claims AI recommendations today.
FEATURE_AI_RECOMMENDATIONS=false

# --- Server-only (never exposed to the browser) ------------------------------

# Optional https:// webhook that receives metadata issue reports.
# Must be https; http and non-URL values are ignored. Leave empty to only log.
OMNISTORE_REPORT_WEBHOOK_URL=

# --- Source submission (/track) ----------------------------------------------
#
# When someone pastes a source OmniSource has not indexed yet, the Track page
# can forward an indexing request. Both variables are optional and server-only:
# the API key is never sent to the browser.

# Intake endpoint that receives indexing requests. MUST be https://.
# Leave empty to disable forwarding — the UI then offers a prefilled
# "Suggest an app" GitHub issue instead, and never claims the request was sent.
OMNISOURCE_SUBMIT_URL=

# API key sent to the intake endpoint as `x-api-key`. Server-side only.
# Never prefix this with NEXT_PUBLIC_ — that would ship it to every visitor.
OMNISOURCE_ADMIN_API_KEY=

# --- Ingest only (never used by the running app) ------------------------------

# GitHub token used by `npm run ingest` to read repository and release metadata.
# Needs no scopes for public repositories. Also picked up from `gh auth login`.
GITHUB_TOKEN=
