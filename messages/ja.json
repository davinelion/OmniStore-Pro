    "sourcesBody": "OmniSource \u306f GitHub\u30fbGitLab\u30fbCodeberg\u30fbForgejo\u30fbF-Droid\u30fbFlathub\u30fbWinget\u30fbHomebrew \u3092\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3057\u307e\u3059\u3002\u30a2\u30d7\u30ea\u306f\u4e0a\u6d41\u3067\u767a\u898b\u30fb\u5f37\u5316\u30fb\u691c\u8a3c\u30fb\u30b9\u30b3\u30a2\u5316\u3055\u308c\u3001OmniStore \u304c\u305d\u306e\u7d50\u679c\u3092\u8868\u793a\u3057\u307e\u3059\u3002",
    "trustTitle": "\u4fe1\u983c\u3068\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3",
    "trustBody": "\u4fe1\u983c\u30b9\u30b3\u30a2\u30fb\u30d0\u30c3\u30b8\u30fb\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u8a3c\u8de1\u306f OmniSource \u5185\u3067\u516c\u958b\u30b7\u30b0\u30ca\u30eb\uff08\u30ea\u30ea\u30fc\u30b9\u306e\u4e00\u8cab\u6027\u3001\u30b3\u30f3\u30c8\u30ea\u30d3\u30e5\u30fc\u30bf\u30fc\u306e\u591a\u69d8\u6027\u3001\u6210\u679c\u7269\u306e\u691c\u8a3c\u3001\u30b9\u30ad\u30e3\u30f3\u7d50\u679c\uff09\u304b\u3089\u8a08\u7b97\u3055\u308c\u3001\u5e38\u306b\u305d\u306e\u8981\u7d20\u3068\u3068\u3082\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002",
    "honestyTitle": "\u8aa0\u5b9f\u3055\u306e\u30eb\u30fc\u30eb",
    "honestyBody": "\u4f55\u3082\u634f\u9020\u3057\u307e\u305b\u3093\u3002\u4e0a\u6d41\u306b\u306a\u3044\u30c7\u30fc\u30bf\u306f\u300c\u60c5\u5831\u306a\u3057\u300d\u3068\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u306f\u691c\u8a3c\u6e08\u307f\u30d1\u30c3\u30b1\u30fc\u30b8\u306e\u307f\u3002\u691c\u8a3c\u306f\u30de\u30eb\u30a6\u30a7\u30a2\u4fdd\u8a3c\u3067\u306f\u306a\u304f\u3001OmniStore \u306f\u305d\u308c\u3092\u6c7a\u3081\u3066\u4e3b\u5f35\u3057\u307e\u305b\u3093\u3002"
  },
  "privacy": {
    "title": "\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc",
    "body1": "OmniStore \u306f\u5e83\u544a\u8b58\u5225\u5b50\u3092\u4fdd\u5b58\u305b\u305a\u3001\u7b2c\u4e09\u8005\u30c8\u30e9\u30c3\u30ab\u30fc\u3082\u52d5\u304b\u3057\u307e\u305b\u3093\u3002",
    "body2": "\u304a\u6c17\u306b\u5165\u308a\u30fb\u30d6\u30c3\u30af\u30de\u30fc\u30af\u30fb\u30b3\u30ec\u30af\u30b7\u30e7\u30f3\u306f\u30d6\u30e9\u30a6\u30b6\uff08IndexedDB\uff09\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u540c\u671f\u306e\u305f\u3081\u30b5\u30a4\u30f3\u30a4\u30f3\u3059\u308b\u3068\u3001\u30b9\u30c8\u30a2\u306f\u30e1\u30fc\u30eb\u305d\u306e\u3082\u306e\u3067\u306f\u306a\u304f\u4e00\u65b9\u5411\u5c0e\u51fa\u5024\u3067\u30e9\u30a4\u30d6\u30e9\u30ea\u3092\u7d10\u4ed8\u3051\u307e\u3059\u3002",
    "body3": "\u30aa\u30d7\u30c8\u30a4\u30f3\u306e\u30ab\u30a6\u30f3\u30c8\u306e\u307f\u306e\u5206\u6790\u306f\u51fa\u6765\u4e8b\u306e\u767a\u751f\u3060\u3051\u3092\u8a18\u9332\u3057\u3001\u8ab0\u306e\u3082\u306e\u304b\u306f\u6c7a\u3057\u3066\u8a18\u9332\u3057\u307e\u305b\u3093\u3002",
    "body4": "\u5916\u90e8\u30ea\u30f3\u30af\u306b\u306f strict-origin-when-cross-origin \u306e\u30ea\u30d5\u30a1\u30e9\u30fc\u30dd\u30ea\u30b7\u30fc\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"
  },
  "terms": {
    "title": "\u5229\u7528\u898f\u7d04",
    "body1": "OmniStore \u306f\u30aa\u30fc\u30d7\u30f3\u30bd\u30fc\u30b9\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30e1\u30bf\u30c7\u30fc\u30bf\u3092\u8868\u793a\u3057\u307e\u3059\u3002\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u306f\u4e0a\u6d41\u306e\u30ea\u30ea\u30fc\u30b9\u30db\u30b9\u30c8\u3067\u884c\u308f\u308c\u3001OmniStore \u306f\u30d0\u30a4\u30ca\u30ea\u3092\u30df\u30e9\u30fc\u30fb\u518d\u30d1\u30c3\u30b1\u30fc\u30b8\u3057\u307e\u305b\u3093\u3002",
    "body2": "\u4fe1\u983c\u30fb\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u60c5\u5831\u306f\u53c2\u8003\u76ee\u7684\u3067\u73fe\u72b6\u6709\u59ff\u3067\u63d0\u4f9b\u3055\u308c\u307e\u3059\u3002\u4fdd\u8a3c\u3067\u3082\u30de\u30eb\u30a6\u30a7\u30a2\u4e0d\u5728\u306e\u8a3c\u660e\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u3002",
    "body3": "\u5546\u6a19\u304a\u3088\u3073\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u540d\u306f\u5404\u6240\u6709\u8005\u306b\u5e30\u5c5e\u3057\u307e\u3059\u3002"
  },
