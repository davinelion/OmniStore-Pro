  "footer": {
    "about": "\u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u0645\u062a\u062c\u0631 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0644\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0645\u0641\u062a\u0648\u062d\u0629 \u0627\u0644\u0645\u0635\u062f\u0631. \u062a\u064f\u0642\u062f\u064e\u0651\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0623\u0645\u0627\u0646 \u0648\u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0627\u062a \u0645\u0646 OmniSource Pro.",
