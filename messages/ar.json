  "about": {
    "title": "\u062d\u0648\u0644 \u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631",
    "intro": "\u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u0647\u0648 \u0627\u0644\u0648\u0627\u062c\u0647\u0629\u061b OmniSource Pro \u0647\u0648 \u0627\u0644\u0645\u062d\u0631\u0643. \u0645\u0635\u062f\u0631 \u062d\u0642\u064a\u0642\u0629 \u0648\u0627\u062d\u062f \u0628\u0644\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0643\u0631\u0631\u0629.",
    "architectureTitle": "\u0627\u0644\u0628\u0646\u064a\u0629",
    "architectureBody": "\u064a\u0633\u062a\u0647\u0644\u0643 \u0639\u0645\u0644\u0627\u0621 \u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 (\u0627\u0644\u0648\u064a\u0628\u060c iOS\u060c Android\u060c \u0633\u0637\u062d \u0627\u0644\u0645\u0643\u062a\u0628) \u0639\u0642\u062f REST \u0648\u0627\u062d\u062f\u064b\u0627 \u0645\u0646 OmniSource Pro: \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0648\u0627\u0644\u0628\u062d\u062b \u0648\u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0627\u062a \u0648\u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0623\u0645\u0627\u0646. \u0644\u0627 \u0643\u062a\u0627\u0644\u0648\u062c \u0645\u062d\u0644\u064a \u0648\u0644\u0627 \u0641\u0647\u0631\u0633 \u0628\u062d\u062b \u0645\u0643\u0631\u0631 \u0648\u0644\u0627 \u062a\u0646\u0642\u064a\u0637 \u0641\u064a \u0627\u0644\u0639\u0645\u064a\u0644.",
    "sourcesTitle": "\u0645\u0646 \u0623\u064a\u0646 \u062a\u0623\u062a\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a",
    "sourcesBody": "\u064a\u0641\u0647\u0631\u0633 OmniSource: GitHub \u0648GitLab \u0648Codeberg \u0648Forgejo \u0648F-Droid \u0648Flathub \u0648Winget \u0648Homebrew. \u062a\u064f\u0643\u062a\u0634\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0648\u062a\u064f\u062b\u0631\u0649 \u0648\u062a\u064f\u062a\u062d\u0642\u0642 \u0648\u062a\u064f\u0646\u0642\u0651\u0637 \u0641\u064a \u0627\u0644\u0645\u0646\u0628\u0639\u061b \u0648\u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u064a\u0639\u0631\u0636 \u0627\u0644\u0646\u062a\u064a\u062c\u0629.",
    "trustTitle": "\u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0623\u0645\u0627\u0646",
    "trustBody": "\u062a\u064f\u062d\u0633\u0628 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0634\u0627\u0631\u0627\u062a \u0648\u0623\u062f\u0644\u0629 \u0627\u0644\u0623\u0645\u0627\u0646 \u062f\u0627\u062e\u0644 OmniSource \u0645\u0646 \u0625\u0634\u0627\u0631\u0627\u062a \u0639\u0627\u0645\u0629 \u2014 \u0627\u062a\u0633\u0627\u0642 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a\u060c \u062a\u0646\u0648\u0639 \u0627\u0644\u0645\u0633\u0627\u0647\u0645\u064a\u0646\u060c \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0644\u0641\u0627\u062a\u060c \u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0645\u0627\u0633\u062d\u0627\u062a \u2014 \u0648\u062a\u064f\u0639\u0631\u0636 \u062f\u0627\u0626\u0645\u064b\u0627 \u0628\u0639\u0648\u0627\u0645\u0644\u0647\u0627.",
    "honestyTitle": "\u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0635\u062f\u0642",
    "honestyBody": "\u0644\u0627 \u0634\u064a\u0621 \u0645\u064f\u062e\u062a\u0644\u0642. \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u063a\u0627\u0626\u0628\u0629 \u062a\u064f\u0639\u0631\u0636 \u00ab\u063a\u064a\u0631 \u0645\u062a\u0648\u0641\u0631\u00bb. \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u064f\u062a\u062d\u0642\u0642 \u0645\u0646\u0647\u0627 \u0641\u0642\u0637 \u062a\u064f\u0639\u0631\u0636 \u0644\u0644\u062a\u0646\u0632\u064a\u0644. \u0627\u0644\u062a\u062d\u0642\u0642 \u0644\u064a\u0633 \u0636\u0645\u0627\u0646\u064b\u0627 \u0645\u0646 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0627\u0644\u062e\u0628\u064a\u062b\u0629\u060c \u0648\u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u0644\u0627 \u064a\u062f\u0651\u0639\u064a \u0630\u0644\u0643 \u0623\u0628\u062f\u064b\u0627."
  },
  "privacy": {
    "title": "\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629",
    "body1": "\u0644\u0627 \u064a\u062e\u0632\u0651\u0646 \u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0625\u0639\u0644\u0627\u0646\u064a\u0629 \u0648\u0644\u0627 \u064a\u0634\u063a\u0651\u0644 \u0645\u062a\u062a\u0628\u0639\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629.",
    "body2": "\u0645\u0641\u0636\u0644\u062a\u0643 \u0648\u0639\u0644\u0627\u0645\u0627\u062a\u0643 \u0648\u0645\u062c\u0645\u0648\u0639\u0627\u062a\u0643 \u062a\u0639\u064a\u0634 \u0641\u064a \u0645\u062a\u0635\u0641\u062d\u0643 (IndexedDB). \u0639\u0646\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0644\u0645\u0632\u0627\u0645\u0646\u0629\u060c \u062a\u064f\u0631\u0641\u0642 \u0645\u0643\u062a\u0628\u062a\u0643 \u0628\u0627\u0634\u062a\u0642\u0627\u0642 \u0623\u062d\u0627\u062f\u064a \u0627\u0644\u0627\u062a\u062c\u0627\u0647 \u0645\u0646 \u0628\u0631\u064a\u062f\u0643 \u2014 \u0644\u0627 \u0627\u0644\u0628\u0631\u064a\u062f \u0646\u0641\u0633\u0647 \u0623\u0628\u062f\u064b\u0627.",
    "body3": "\u0642\u062f \u062a\u0633\u062c\u0644 \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u0627\u062a \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631\u064a\u0629 \u0627\u0644\u0639\u062f\u0651\u064a\u0629 \u0623\u0646 \u062d\u062f\u062b\u064b\u0627 \u0648\u0642\u0639\u060c \u0644\u0627 \u0644\u0645\u0646.",
    "body4": "\u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0645\u064f\u062d\u064a\u0644 strict-origin-when-cross-origin."
  },
  "terms": {
    "title": "\u0627\u0644\u0634\u0631\u0648\u0637",
    "body1": "\u064a\u0639\u0631\u0636 \u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0635\u0641\u064a\u0629 \u0639\u0646 \u0645\u0634\u0627\u0631\u064a\u0639 \u0645\u0641\u062a\u0648\u062d\u0629 \u0627\u0644\u0645\u0635\u062f\u0631. \u062a\u064f\u062a\u0627\u0628\u0639 \u0627\u0644\u062a\u0646\u0632\u064a\u0644\u0627\u062a \u0639\u0644\u0649 \u0645\u0636\u064a\u0641 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0623\u0635\u0644\u064a\u061b \u0644\u0627 \u064a\u0646\u0633\u062e \u0623\u0648\u0645\u0646\u064a \u0633\u062a\u0648\u0631 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u0629.",
    "body2": "\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062b\u0642\u0629 \u0648\u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0633\u062a\u0631\u0634\u0627\u062f\u064a\u0629 \u0648\u062a\u064f\u0642\u062f\u064e\u0651\u0645 \u0643\u0645\u0627 \u0647\u064a. \u0644\u064a\u0633\u062a \u0636\u0645\u0627\u0646\u064b\u0627 \u0648\u0644\u0627 \u0625\u0642\u0631\u0627\u0631\u064b\u0627 \u0628\u062e\u0644\u0648 \u0645\u0646 \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0627\u0644\u062e\u0628\u064a\u062b\u0629.",
    "body3": "\u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0644\u0623\u0635\u062d\u0627\u0628\u0647\u0627."
  },
